{
  "name": "doulor-mail-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.toml",
    "deploy": "wrangler deploy --config wrangler.toml --name doulor-mail-api",
    "db:init": "wrangler d1 execute doulor-mail --file=./schema.sql",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:handlers": "node scripts/check-handlers.mjs",
    "check": "node scripts/check-handlers.mjs && tsc --noEmit",
    "routes:check": "node scripts/check-routes.mjs",
    "routes:fix": "node scripts/check-routes.mjs --fix"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.2.3",
    "@cloudflare/workers-types": "^5.20260921.0",
    "@vitest/runner": "4.1.11",
    "@vitest/snapshot": "4.1.11",
    "typescript": "^7.0.2",
    "vitest": "4.1.11",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "postal-mime": "^3.0.0"
  }
}
