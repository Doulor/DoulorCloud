{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://cloud.doulor.cn",
          "https://mail.doulor.cn",
          "https://doulor.cn"
        ],
        "methods": ["GET", "PUT", "HEAD"],
        "headers": ["*"]
      },
      "exposeHeaders": ["ETag", "Content-Length", "Content-Range"],
      "maxAgeSeconds": 3600
    }
  ]
}