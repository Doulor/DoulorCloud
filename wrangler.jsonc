{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "doulor-mail",
  "compatibility_date": "2026-09-18",
  "main": "site-worker.js",
  "account_id": "83fdea7d910cbc683e6d53fa6baf45ab",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "cloud.doulor.cn",
      "custom_domain": true
    }
  ]
}
